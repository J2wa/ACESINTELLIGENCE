# Separate prospect database. Do NOT reuse the Workhub database without approval.
PROSPECT_DATABASE_URL=
PROSPECT_DATABASE_TOKEN=
# JSON array of {id, role: founder|va1|va2|ai1|ai2, tokenHash: SHA256, disabled:false}
# Store only hashed high-entropy per-seat tokens. Never commit actual credentials.
PROSPECT_SEATS_JSON=
PROSPECT_MIGRATION_APPROVED=no
# Live provider operations are off until the founder explicitly authorizes them.
PROSPECT_LIVE_PROVIDERS=false
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=
