{"$schema": "https://openapi.vercel.sh/vercel.json", "cleanUrls": true, "outputDirectory": "public", "functions": {"api/submit.js": {"maxDuration": 30}}, "headers": [{"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Frame-Options", "value": "DENY"}]}], "rewrites": [{"source": "/api/auth/:path*", "destination": "/api/auth"}, {"source": "/api/auth-status", "destination": "/api/auth"}], "redirects": [{"source": "/", "has": [{"type": "host", "value": "login.acesintelligence.xyz"}], "destination": "/team-login", "permanent": false}]}