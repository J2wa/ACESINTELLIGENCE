# Copy to .env.local for local use; enter production values in Vercel Environment Variables.
APP_URL=http://localhost:3000
# Local development only. On Vercel use libsql://your-database.turso.io and its token.
TURSO_DATABASE_URL=file:workhub.db
TURSO_AUTH_TOKEN=
# Creates the initial admin if the email does not already exist.
ADMIN_EMAIL=
ADMIN_NAME=
# Generate with scripts/hash-password.mjs (password on stdin). Never store plaintext.
ADMIN_PASSWORD_HASH=
# Google OAuth web client; callback: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ONLY=false
# Optional tracker sync; service-account JSON including its private key.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional standalone API bootstrap, leave empty when using admin env provisioning.
BOOTSTRAP_TOKEN=
# Local sample seed only; minimum 12-character passwords.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
